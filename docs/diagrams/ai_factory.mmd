flowchart LR
    DataSrc(["Data<br/>10K subscribers<br/>CRM · CDR · billing · NPS"])

    subgraph DP["Data Pipeline"]
      direction LR
      G["Gather<br/>CSV / ETL load"]
      CL["Clean<br/>NPS imputation<br/>ID dedupe"]
      N["Normalize<br/>StandardScaler<br/>for LR baseline"]
      INT["Integrate<br/>18 engineered<br/>features"]
      G --> CL --> N --> INT
    end

    subgraph AD["Algorithm Development"]
      ALG["<b>Supervised:</b> XGBoost (primary, class-balanced) · Logistic Regression baseline<br/><b>Other AI:</b> Anthropic Claude Sonnet 4 (transformer LLM, prompt-based, no fine-tuning)<br/><b>Rule-based:</b> NPS ≤ 4 OR complaints ≥ 2 OR days-since-topup &gt; 10"]
    end

    subgraph ID["Infrastructure Development"]
      INF["<b>Workflows:</b> Next.js API routes · Python training script · GitHub Actions CI<br/><b>Compute:</b> Vercel serverless · Anthropic API · scikit-learn pipeline<br/><b>Storage:</b> CSV dataset · churn_model.pkl · model_metadata.json<br/><b>Analytics:</b> scikit-learn metrics · PR-curve · confusion matrix"]
    end

    EXP["<b>Experimentation Platform</b><br/>PR-curve F1-optimal threshold tuning (0.40)<br/>Baseline benchmark (XGBoost vs LR vs rule-based)<br/>Edge-case stress projections<br/>Go / No-Go panel + business impact estimate"]

    PROD["<b>Productize &amp; Deploy</b><br/>Vercel auto-deploy from GitHub<br/>9 modules live for CVM team<br/>7 Claude routes + 2 outbound + 1 feedback sink<br/>Weekly retrain trigger via /api/feedback"]

    DataSrc --> G
    DataSrc --> ALG
    DataSrc --> INF

    INT --> EXP
    ALG --> EXP
    INF --> EXP
    EXP --> PROD

